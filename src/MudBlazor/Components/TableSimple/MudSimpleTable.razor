@namespace MudBlazor
@inherits MudComponentBase

<div @attributes="UserAttributes" class="@Classname" style="@Style" >
    <div class="mud-table-container">
        @if (OverrideContent == null)
        {
            <table>
                @ChildContent
            </table>
        }
        else
        {
            @OverrideContent
        }
    </div>
</div>
